#!/bin/bash

addVPNUser() {
    ipsec_secrets=$1
    sudo -l > /dev/null
    echo 'Please input username and password!'
    echo 'If no password provided, your password will be randomly generated! (recommended)'

    # only letters, digits and . _ @ -, so the name can't break the ipsec.secrets format;
    # ask again until the name is valid and new (stop at end of input)
    read -r -p 'User name: ' new_user || return 1
    while [[ ! $new_user =~ ^[A-Za-z0-9._@-]+$ ]] ||
        sudo awk -v u="$new_user" '$1 == u { found = 1 } END { exit !found }' "$ipsec_secrets"; do
        echo "User name '$new_user' is invalid or already exists!"
        read -r -p 'User name: ' new_user || return 1
    done

    # the password is written inside double quotes, so it can't contain one
    read -r -s -p 'User password: ' new_passwd || return 1
    while [[ $new_passwd == *'"'* ]]; do
        echo -e '\nPassword must not contain a double quote (")!'
        read -r -s -p 'User password: ' new_passwd || return 1
    done
    [[ $new_passwd == '' ]] && new_passwd=$(openssl rand -base64 32 | head -c 32) && echo -e "\n-----\nYour password is $new_passwd"
    echo "$new_user : EAP \"$new_passwd\"" | sudo tee -a $ipsec_secrets >/dev/null
    sudo systemctl restart strongswan-starter
}

backup() {
    fpath=$1
    # keep the first backup: on a re-run the file has already been modified
    [[ -e $fpath.bak ]] || sudo cp $fpath{,.bak}
}
